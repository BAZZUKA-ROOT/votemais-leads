# ======================================================================
# VoteMais Leads — variáveis de ambiente
# Copie para .env (raiz, usado pelo docker compose) ou server/.env (dev).
# ======================================================================

# --- Aplicação ---
NODE_ENV=production
APP_URL=https://leads.votemais.online
API_HOST=0.0.0.0
API_PORT=4000
# true quando atrás de proxy reverso (Caddy/Nginx) para obter o IP real
TRUST_PROXY=true
LOG_LEVEL=info
SESSION_TTL_HOURS=72
# Cookies "Secure" (padrão: true em produção)
# COOKIE_SECURE=true

# Chave de 32 bytes que cifra as credenciais das integrações (AES-256-GCM).
# Gere com: openssl rand -hex 32   — NÃO perca: sem ela as chaves salvas não podem ser lidas.
APP_ENCRYPTION_KEY=

# --- Banco de dados (PostgreSQL 16) ---
POSTGRES_USER=votemais
POSTGRES_PASSWORD=
POSTGRES_DB=votemais_leads
DATABASE_URL=postgres://votemais:SENHA@postgres:5432/votemais_leads
DB_POOL_MAX=10

# --- Redis (filas BullMQ, rate limit, locks) ---
REDIS_URL=redis://redis:6379
QUEUE_PREFIX=vml

# --- Crawler ---
CRAWLER_USER_AGENT=VoteMaisLeadsBot/1.0 (+https://leads.votemais.online/bot)

# --- Frontend (Next.js) ---
# URL interna da API usada pelos rewrites /api/* (definida no BUILD da imagem web)
API_INTERNAL_URL=http://api:4000

# --- SearXNG (opcional, self-hosted) ---
SEARXNG_SECRET=

# --- Primeiro administrador (usado apenas pelo seed quando não há usuários) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# As chaves de Anthropic, Brave, Serper, Tavily, Google e n8n são cadastradas
# pela tela Integrações (armazenadas cifradas no banco), não aqui.
